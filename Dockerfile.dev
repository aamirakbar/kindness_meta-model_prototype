
# Dockerfile.dev

# This Dockerfile is used for development. It is designed for fast iteration, as it:
# - Uses bind mount to map your source code from the host into the container.
# - Runs uvicorn with --reload so server restarts automatically on file changes.
# - Lets you edit in VS Code and see changes immediately in the running container.
# - You build once, then you generally don't rebuild when editing code.

# Use official Python image
FROM python:3.11-slim

# System basics (optional tools but helps with building packages & debugging)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl vim \
    && rm -rf /var/lib/apt/lists/*

# In-container working directory (the repo is mounted here)
WORKDIR /workspace


# Copy only requirements to leverage Docker layer caching
COPY requirements.txt ./

# Install deps (include watchfiles for uvicorn --reload)
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install watchfiles

# Expose FastAPI port
EXPOSE 8000

# Default command (you can override in docker run)
CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
